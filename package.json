{
  "name": "bcs-universal-notify",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/web", "packages/ui", "packages/contracts"],
  "engines": { "node": ">=24.15.0 <25", "npm": ">=11 <12" },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "npm run dev --workspace=@bcs/web",
    "build": "npm run build --workspace=@bcs/web",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings apps/web packages/ui packages/contracts tests",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
