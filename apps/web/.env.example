# SAFE TEMPLATE ONLY. Copy to apps/web/.env.local (Git ignored).
BCS_DATA_MODE=synthetic
# Opt into database only after separately approved 010 and owner verification.
BCS_RUNTIME_ROLE_VERIFIED=
# Use only a NEW, privately provisioned credential, never the previously exposed password.
# Database path must be /postgres. No URI query options or fragments.
# Dedicated bcs_recipient_reader URI from bcs-dev Connect; never postgres/service_role.
BCS_DATABASE_URL=
# Absolute local path to official Supabase CA certificate. Verification is mandatory.
BCS_DATABASE_CA_FILE=
# Owner-resolved synthetic UUIDs; server only. Exact codes verified on every request.
BCS_DEMO_COMPANY_ID=
BCS_DEMO_PORTAL_ID=
