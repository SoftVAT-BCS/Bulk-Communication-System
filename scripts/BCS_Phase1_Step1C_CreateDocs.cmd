@echo off
setlocal DisableDelayedExpansion
rem BCS Phase 1 Step 1C - local documentation setup only.
rem Review the plain-text Markdown ZIP or open this file in Notepad before running.
set "BCS_DOCS_SELF=%~f0"
if not exist "%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" (
    echo [STOP] Windows PowerShell was not found. No setup changes were made.
    endlocal
    exit /b 1
)
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -NonInteractive -Command "$ErrorActionPreference='Stop'; try { $raw=[IO.File]::ReadAllText($env:BCS_DOCS_SELF); $mark=[Environment]::NewLine+'# BCS_POWERSHELL_PAYLOAD_START'+[Environment]::NewLine; $i=$raw.IndexOf($mark,[StringComparison]::Ordinal); if($i -lt 0){throw 'Setup payload marker not found.'}; & ([scriptblock]::Create($raw.Substring($i+$mark.Length))); } catch { Write-Host ('[STOP] '+$_.Exception.Message); exit 1 }"
set "BCS_SETUP_RESULT=%ERRORLEVEL%"
endlocal & exit /b %BCS_SETUP_RESULT%
# BCS_POWERSHELL_PAYLOAD_START
# BCS Step 1C. Local documentation setup only. Compatible with Windows PowerShell 5.1.
# No network calls, installs, Git operations, application code, policy changes or IPX writes.
Set-StrictMode -Version 2.0
$ErrorActionPreference = 'Stop'
$Root = 'E:\Bulk-Communicatio-System'
$PackId = 'BCS-PHASE1-STEP1C-1.0'
$Utf8 = New-Object System.Text.UTF8Encoding($false)
$Created = @()
$Kept = @()
$WritesStarted = $false

function Hash-Bytes {
    param([byte[]]$Bytes)
    $sha = [System.Security.Cryptography.SHA256]::Create()
    try { return ([System.BitConverter]::ToString($sha.ComputeHash($Bytes))).Replace('-', '').ToLowerInvariant() }
    finally { $sha.Dispose() }
}

function Hash-File {
    param([string]$Path)
    return (Get-FileHash -LiteralPath $Path -Algorithm SHA256 -ErrorAction Stop).Hash.ToLowerInvariant()
}

function Assert-NormalPath {
    param([string]$Path)
    # Reject existing junctions/symbolic links along the destination or source path.
    $node = [System.IO.Path]::GetFullPath($Path)
    while (-not [string]::IsNullOrEmpty($node)) {
        if (Test-Path -LiteralPath $node) {
            $item = Get-Item -LiteralPath $node -Force -ErrorAction Stop
            if (($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) {
                throw ('Reparse point/junction/symbolic link is not allowed: ' + $node)
            }
        }
        $parent = [System.IO.Path]::GetDirectoryName($node)
        if ($parent -eq $node) { break }
        $node = $parent
    }
}

function Resolve-SafeTarget {
    param([string]$RelativePath)
    if ([string]::IsNullOrWhiteSpace($RelativePath) -or
        $RelativePath.Contains('..') -or $RelativePath.Contains(':') -or
        $RelativePath.Contains('\') -or $RelativePath.StartsWith('/')) {
        throw ('Unsafe target path: ' + $RelativePath)
    }
    if ($RelativePath -cne 'AGENTS.md' -and $RelativePath -cnotmatch '^docs/[A-Za-z0-9_/-]+\.(md|json)$') {
        throw ('Target is outside the documentation allowlist: ' + $RelativePath)
    }
    $target = [System.IO.Path]::GetFullPath((Join-Path -Path $Root -ChildPath $RelativePath))
    $prefix = $Root + [System.IO.Path]::DirectorySeparatorChar
    if (-not $target.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase)) {
        throw ('Target escapes the canonical workspace: ' + $RelativePath)
    }
    Assert-NormalPath $target
    $parent = [System.IO.Path]::GetDirectoryName($target)
    if (-not [System.IO.Directory]::Exists($parent)) {
        throw ('Required parent directory is missing: ' + $parent)
    }
    if ([System.IO.Directory]::Exists($target)) {
        throw ('An existing directory occupies a target file path: ' + $target)
    }
    return $target
}

function Read-IpxSnapshot {
    $ipxRoot = Join-Path $Root 'IPX'
    Assert-NormalPath $ipxRoot
    $queue = New-Object 'System.Collections.Generic.Queue[string]'
    $queue.Enqueue($ipxRoot)
    $records = @()
    while ($queue.Count -gt 0) {
        $directory = $queue.Dequeue()
        foreach ($item in @(Get-ChildItem -LiteralPath $directory -Force -ErrorAction Stop)) {
            if (($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) {
                throw ('IPX contains a junction/symbolic link. No setup writes permitted: ' + $item.FullName)
            }
            if ($item.PSIsContainer) {
                $queue.Enqueue($item.FullName)
            } else {
                $relative = $item.FullName.Substring($ipxRoot.Length + 1).Replace('\', '/')
                $records += [pscustomobject][ordered]@{
                    path = $relative
                    length = [long]$item.Length
                    sha256 = Hash-File $item.FullName
                }
            }
        }
    }
    $records = @($records | Sort-Object -Property path)
    if ($records.Count -eq 0) { throw 'The IPX tree is empty.' }
    $lines = @($records | ForEach-Object { $_.path + '|' + $_.length.ToString([System.Globalization.CultureInfo]::InvariantCulture) + '|' + $_.sha256 })
    $digest = Hash-Bytes ($Utf8.GetBytes(($lines -join "`n")))
    return [pscustomobject][ordered]@{
        schemaVersion = 1
        relativeRoot = 'IPX'
        fileCount = $records.Count
        treeSha256 = $digest
        files = $records
    }
}

function Write-NewVerifiedFile {
    param([string]$Path, [byte[]]$Bytes, [string]$ExpectedHash)
    # CreateNew is deliberate: never use Create, Truncate, WriteAllText or Set-Content.
    # A concurrent new file causes an exception, not an overwrite.
    Assert-NormalPath $Path
    $stream = [System.IO.File]::Open($Path, [System.IO.FileMode]::CreateNew, [System.IO.FileAccess]::Write, [System.IO.FileShare]::None)
    try {
        $stream.Write($Bytes, 0, $Bytes.Length)
        $stream.Flush()
    } finally { $stream.Dispose() }
    if ((Hash-File $Path) -cne $ExpectedHash) {
        throw ('New file failed hash verification: ' + $Path)
    }
}

try {
    Write-Host '=============================================='
    Write-Host 'BCS PHASE 1 - STEP 1C: MASTER DOCUMENTATION'
    Write-Host '=============================================='
    Write-Host ('Workspace: ' + $Root)
    Write-Host 'Mode: no overwrite; documentation only; no live connections.'
    Write-Host ''

    if ($PSVersionTable.PSVersion -lt [Version]'5.1') { throw 'Windows PowerShell 5.1 or later is required.' }
    if ([System.Environment]::OSVersion.Platform -ne [System.PlatformID]::Win32NT) { throw 'This launcher is intended for the confirmed Windows workspace only.' }
    $Root = [System.IO.Path]::GetFullPath($Root)
    if (-not [System.IO.Directory]::Exists($Root)) { throw ('Canonical workspace not found: ' + $Root) }
    Assert-NormalPath $Root

    $RequiredDirectories = @(
        'IPX/IPX-BCS/Assets', 'apps/web', 'apps/api', 'apps/worker',
        'packages/ui', 'packages/contracts', 'packages/config', 'packages/integrations',
        'packages/notification-core', 'packages/email-providers', 'database/migrations',
        'database/seeds', 'docs/architecture', 'docs/adr', 'docs/standards',
        'docs/requirements', 'docs/handover', 'docs/reference', 'scripts',
        'tests/unit', 'tests/integration', 'tests/e2e', 'tests/security', 'tests/visual'
    )
    foreach ($relative in $RequiredDirectories) {
        $path = Join-Path $Root $relative
        if (-not [System.IO.Directory]::Exists($path)) { throw ('Step 1B folder missing: ' + $relative) }
        Assert-NormalPath $path
    }
    foreach ($relative in @('index.html','dashboard.html','communication.html','scheduling.html','reports.html','configuration.html','Assets/app.js','Assets/styles.css','Assets/favicon.svg','READ_ME_FIRST.txt','PARTNER_FEEDBACK.txt')) {
        $path = Join-Path (Join-Path $Root 'IPX/IPX-BCS') $relative
        if (-not [System.IO.File]::Exists($path)) { throw ('Expected IPX reference file is missing: ' + $relative) }
        Assert-NormalPath $path
    }
    Write-Host '[CHECK] Workspace, production folders and IPX reference found.'

    # This JSON holds text/data only. Markdown bytes are base64 to preserve characters.
    $payloadText = @'
{"schemaVersion":1,"packId":"BCS-PHASE1-STEP1C-1.0","files":[{"path":"AGENTS.md","sha256":"cd72a76262b2a8efb783b7b6a97b8c8fdee0c02ee0d051a6d89d0819f034d1b9","length":4836,"contentBase64":""},{"path":"docs/README.md","sha256":"4839aef039bdc89decd3eed38b9630bc12877b1eda74e5f8950518e3062a312c","length":4316,"contentBase64":""},{"path":"docs/PROJECT-MASTER.md","sha256":"8379a13462a2be08a21d7e9cbd170142855bfd297fa7c0bc5fe33c2a52834295","length":5743,"contentBase64":""},{"path":"docs/architecture/ARCHITECTURE.md","sha256":"34e021de796cfb0443308d6d9387e3b602bd242a7b7c7a884c6359ccd2f6a988","length":5157,"contentBase64":""},{"path":"docs/architecture/DATABASE-ARCHITECTURE.md","sha256":"a6ffe6634085f852b3e5679bde5242dab217cbcfda6eea178b7b9284100ec208","length":5264,"contentBase64":""},{"path":"docs/standards/UI-DESIGN-SYSTEM.md","sha256":"55bd78a78a57f41b12c920002544f8f886e31c16d98aeab77b7cbdce01a83a59","length":4242,"contentBase64":""},{"path":"docs/standards/REUSABLE-COMPONENTS.md","sha256":"9b3ae89190c031c109633308044ed8fc87a15e864e8b39b4ad1e003fd00cc54c","length":5938,"contentBase64":""},{"path":"docs/standards/SECURITY-STANDARDS.md","sha256":"a8d719fefc9b78f27247e9dfa1c7ee05d37916f64b6026c2bc06ee72034f45e3","length":5027,"contentBase64":""},{"path":"docs/standards/TESTING-AND-ACCEPTANCE.md","sha256":"10254ba262b5ddbd5c5802fc55c8458ad9578a7e34d17f65b55efbe504d6a06d","length":4453,"contentBase64":""},{"path":"docs/requirements/DEVELOPMENT-ROADMAP.md","sha256":"8e70cb8714f97c0cb4e270a02579a7fbefc017a26b73fda8f401bbc7185c86a5","length":4000,"contentBase64":""},{"path":"docs/adr/DECISION-LOG.md","sha256":"79830bf55450fc93c572f4f661dfff0d1a6cab85a4be29dbf524613986caefc6","length":3709,"contentBase64":""},{"path":"docs/handover/WORK-STATUS.md","sha256":"9e9757325956e623aa802515f2fb0a74d5c35ad9861e4c211d7cbce97670addd","length":3763,"contentBase64":""},{"path":"docs/reference/IPX-BASELINE.md","sha256":"98835e86726d154ee63f4cb89806cb411ff13ff00926ca2d050ebbfe492e4d00","length":4163,"contentBase64":""},{"path":"docs/reference/ORIGINAL-PROJECT-HANDOVER.md","sha256":"3e20a50fadc1cdd231ef774cc24e001a68687b1984bd4dbbadc2533695bbaf6a","length":35796,"contentBase64":""}]}
'@
    $payload = $payloadText | ConvertFrom-Json
    if ($payload.schemaVersion -ne 1 -or $payload.packId -cne $PackId -or @($payload.files).Count -ne 14) {
        throw 'Unexpected documentation package format.'
    }

    $before = Read-IpxSnapshot
    Write-Host ('[CHECK] IPX content snapshot captured: ' + $before.fileCount + ' files.')
    $prepared = @()
    $conflicts = @()
    $seen = @{}
    foreach ($file in @($payload.files)) {
        $relative = [string]$file.path
        if ($seen.ContainsKey($relative)) { throw ('Duplicate documentation target: ' + $relative) }
        $seen[$relative] = $true
        $target = Resolve-SafeTarget $relative
        $bytes = [System.Convert]::FromBase64String([string]$file.contentBase64)
        if ($bytes.Length -ne [long]$file.length -or (Hash-Bytes $bytes) -cne [string]$file.sha256) {
            throw ('Packaged content failed verification: ' + $relative)
        }
        $exists = [System.IO.File]::Exists($target)
        if ($exists) {
            if ((Hash-File $target) -cne [string]$file.sha256) {
                $conflicts += $relative
                Write-Host ('[BLOCKED] Existing different file: ' + $relative)
            }
        }
        $prepared += [pscustomobject]@{ relative = $relative; target = $target; bytes = $bytes; sha256 = [string]$file.sha256; exists = $exists }
    }
    if ($conflicts.Count -gt 0) {
        throw 'Existing different documentation found. No new files were created; nothing was overwritten. Share this output.'
    }

    $manifestRelative = 'docs/reference/IPX-BASELINE-SHA256.json'
    $reportRelative = 'docs/handover/STEP-1C-INSTALL-REPORT.json'
    $manifestPath = Resolve-SafeTarget $manifestRelative
    $reportPath = Resolve-SafeTarget $reportRelative
    $manifestExists = [System.IO.File]::Exists($manifestPath)
    $reportExists = [System.IO.File]::Exists($reportPath)
    if ($manifestExists) {
        $saved = [System.IO.File]::ReadAllText($manifestPath, $Utf8) | ConvertFrom-Json
        if ($saved.schemaVersion -ne 1 -or $saved.relativeRoot -cne 'IPX' -or
            $saved.treeSha256 -cne $before.treeSha256 -or $saved.fileCount -ne $before.fileCount) {
            throw 'The existing IPX checksum inventory does not match the current IPX. It will not be replaced. No new files were created.'
        }
        $savedFiles = @($saved.files | Sort-Object -Property path)
        if ($savedFiles.Count -ne $before.fileCount) { throw 'The existing IPX inventory has an invalid file count.' }
        for ($i = 0; $i -lt $savedFiles.Count; $i++) {
            if ($savedFiles[$i].path -cne $before.files[$i].path -or
                [long]$savedFiles[$i].length -ne [long]$before.files[$i].length -or
                $savedFiles[$i].sha256 -cne $before.files[$i].sha256) {
                throw 'The existing IPX inventory file entries differ. It will not be overwritten.'
            }
        }
    }
    if ($reportExists) {
        $oldReport = [System.IO.File]::ReadAllText($reportPath, $Utf8) | ConvertFrom-Json
        if ($oldReport.schemaVersion -ne 1 -or $oldReport.packId -cne $PackId -or
            $oldReport.result -cne 'SUCCESS' -or $oldReport.ipxTreeSha256 -cne $before.treeSha256 -or
            $oldReport.markdownCount -ne 14) {
            throw 'An existing report conflicts with this package or IPX baseline. It will not be overwritten. No new files were created.'
        }
    }
    Write-Host '[CHECK] Preflight passed. Existing identical files will be kept.'
    Write-Host ''

    $WritesStarted = $true
    foreach ($entry in $prepared) {
        if ($entry.exists) {
            $Kept += $entry.relative
            Write-Host ('[KEEP] ' + $entry.relative)
        } else {
            Write-NewVerifiedFile $entry.target $entry.bytes $entry.sha256
            $Created += $entry.relative
            Write-Host ('[CREATED] ' + $entry.relative)
        }
    }
    # Recheck all documents, including existing files retained during this run.
    foreach ($entry in $prepared) {
        Assert-NormalPath $entry.target
        if ((Hash-File $entry.target) -cne $entry.sha256) {
            throw ('Documentation changed during setup: ' + $entry.relative)
        }
    }
    $after = Read-IpxSnapshot
    if ($before.treeSha256 -cne $after.treeSha256 -or $before.fileCount -ne $after.fileCount) {
        throw 'IPX content changed during this run. The setup made no IPX writes; check for concurrent edits. No success report will be created.'
    }

    if ($manifestExists) {
        $Kept += $manifestRelative
        Write-Host ('[KEEP] ' + $manifestRelative)
    } else {
        $bytes = $Utf8.GetBytes(($before | ConvertTo-Json -Depth 8) + "`r`n")
        Write-NewVerifiedFile $manifestPath $bytes (Hash-Bytes $bytes)
        $Created += $manifestRelative
        Write-Host ('[CREATED] ' + $manifestRelative)
    }
    if ($reportExists) {
        $Kept += $reportRelative
        Write-Host ('[KEEP] ' + $reportRelative + ' (historical success report)')
    } else {
        $report = [ordered]@{
            schemaVersion = 1
            packId = $PackId
            result = 'SUCCESS'
            completedUtc = [DateTime]::UtcNow.ToString('o')
            workspace = $Root
            markdownCount = $prepared.Count
            markdownHashesVerified = $true
            existingFilesOverwritten = 0
            ipxFileCount = $after.fileCount
            ipxTreeSha256 = $after.treeSha256
            ipxContentUnchangedDuringSetup = $true
            gitOperationPerformed = $false
            dependenciesInstalled = $false
            networkCallsMade = $false
            applicationOrDatabaseChangesMade = $false
            ownerAcceptance = 'Pending review of CMD output'
            documents = @($prepared | ForEach-Object { [ordered]@{ path = $_.relative; sha256 = $_.sha256 } })
            limitations = 'Checksums are not a backup. Browser storage and future file changes are outside this check. Application tests were not run.'
        }
        $bytes = $Utf8.GetBytes(($report | ConvertTo-Json -Depth 8) + "`r`n")
        Write-NewVerifiedFile $reportPath $bytes (Hash-Bytes $bytes)
        $Created += $reportRelative
        Write-Host ('[CREATED] ' + $reportRelative)
    }

    Write-Host ''
    Write-Host '[VERIFY] 14 populated Markdown files match this package.'
    Write-Host ('[VERIFY] IPX content unchanged: ' + $after.fileCount + ' files.')
    Write-Host ('[SUMMARY] Newly created files: ' + $Created.Count)
    Write-Host ('[SUMMARY] Existing files kept: ' + $Kept.Count)
    Write-Host '[SUMMARY] Existing files overwritten: 0'
    Write-Host '[SUMMARY] No Git operation, installation, database connection or email sending.'
    Write-Host '[SUCCESS] BCS STEP 1C COMPLETE'
    Write-Host ''
    Write-Host 'STOP HERE. Share this output with Anna before the next activity.'
    exit 0
} catch {
    Write-Host ''
    Write-Host ('[STOP] ' + $_.Exception.Message)
    if ($WritesStarted) {
        Write-Host 'Some NEW files may have been created before this stop. Do not delete or overwrite them.'
    } else {
        Write-Host 'Setup stopped before documentation writes.'
    }
    Write-Host 'The setup does not overwrite existing files or write inside IPX.'
    Write-Host 'Share the full output with Anna. Do not bypass permissions or change security settings.'
    exit 1
}
